{
  "name": "AdvisorUsage",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "description": "UTC day key, YYYY-MM-DD"
    },
    "count": {
      "type": "number",
      "default": 0,
      "description": "Advisor requests this user has made on that day"
    }
  },
  "required": [
    "day"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}